# ─────────────────────────────────────────────
# TURK TILI SPEAKING TEST BOT — .env namunasi
# Bu faylni `.env` nomi bilan nusxalang va haqiqiy qiymatlarni kiriting:
#     cp .env.example .env
# ─────────────────────────────────────────────

# ===== TELEGRAM (MAJBURIY) =====
# @BotFather dan olingan bot token (format: 123456789:AAAbBcC...)
BOT_TOKEN=your_bot_token_here

# Adminlarning Telegram ID lari (vergul bilan ajratiladi)
ADMIN_IDS=123456789,987654321

# ===== DATABASE (MAJBURIY) =====
# PostgreSQL ulanish URL — faqat postgresql+asyncpg:// qo'llab-quvvatlanadi
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# ===== WEBAPP =====
# Lokal: NGROK_AUTHTOKEN qo'yilgan bo'lsa — URL avtomatik ngrok'dan olinadi.
# Railway: bo'sh qoldiring — Railway domeni avtomatik olinadi; o'z domeningiz
# ulangach: WEBAPP_URL=https://test.sizningdomen.uz
WEBAPP_URL=

# ===== NGROK TUNNEL (faqat lokal kompyuter uchun) =====
# https://dashboard.ngrok.com dan olinadi. Railway'da KERAK EMAS.
NGROK_AUTHTOKEN=

# ===== STT (Ovoz → Matn) =====
# Provider: "gemini", "groq" yoki "openai"
STT_PROVIDER=gemini

# Gemini kaliti (bitta)
GEMINI_API_KEY=
# Bir nechta Gemini kaliti (vergul bilan): key1,key2,key3
GEMINI_API_KEYS=
# Tavsiya: gemini-3.6-flash (eski 1.5/2.0/2.5-flash yangi kalitlarda yopilgan)
GEMINI_STT_MODEL=gemini-3.6-flash

# Groq STT kaliti va modeli (STT_PROVIDER=groq bo'lsa)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# ===== AI BAHOLASH =====
# Baholash provideri: "openai" yoki "groq"
AI_PROVIDER=openai

# ╔══════════════════════════════════════════════════════╗
# ║  GEMINI PAID (PRO) API — 100 USER UCHUN OPTIMALLASH  ║
# ╚══════════════════════════════════════════════════════╝
# Gemini API RPM (requests per minute):
#   - Free tier:   15 per key  (eski qiymat)
#   - Paid Tier 1: 300+ per key (Gemini AI Studio → Dashboard → Rate limits)
# Yodda tuting: haqiqiy limitni AI Studio'dan tekshiring.
GEMINI_RPM_PER_KEY=300

# ===== DB CONNECTION POOL (100+ user uchun) =====
# Pool size + overflow = jami max connection (30+30=60)
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=30

# ===== REPORT WORKERS (AI baholash tezligi) =====
# Har bir worker bitta attempt'ni parallel qayta ishlaydi.
# 50 user uchun: 12-15 worker tavsiya etiladi
# 100 user uchun: 15-20 worker tavsiya etiladi
REPORT_WORKERS=15

# ===== UPLOAD SEMAPHORE =====
# Bir vaqtda nechta audio upload parallel bo'lishi (100 user = 100)
UPLOAD_SEMAPHORE=100

# ===== TELEGRAM YUBORISH TEZLIGI =====
# Telegram API limit ~30 msg/s (xavfsiz: 25-30)
# 50 user uchun: 25-30 msg/s yetarli
# 100 user uchun: 30-35 msg/s tavsiya etiladi
TELEGRAM_RATE_PER_SECOND=30

# ===== CORS =====

# OpenAI (tavsiya: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq chat (AI_PROVIDER=groq bo'lsa)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Vision — docx savollarni tahlil qilish uchun (Groq)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ===== FAYLLAR =====
# Audio/rasm papkasi (loyiha ichida)
UPLOAD_DIR=data/audios
# Bitta audio fayl uchun maksimal hajm (MB)
MAX_AUDIO_SIZE_MB=50

# ===== CORS =====
# "*" — hamma domendan, yoki domеnlar vergul bilan:
# CORS_ORIGINS=https://site1.com,https://site2.com
CORS_ORIGINS=*

# ===== LOGLAR =====
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== KUNLIK HISOBOT =====
# Har kuni shu vaqt mintaqasida 00:00 da Word hisobot adminlarga yuboriladi
REPORT_TIMEZONE=Asia/Tashkent

# AI hamma javoblarni tekshirib bo'lgach adminlarga [Ha] [Yo'q] tugmalari
# chiqadi: oxirgi tekshiruvdan keyin shuncha soniya kutiladi
AUTO_REPORT_ENABLED=true
AUTO_REPORT_DELAY_SECONDS=30
