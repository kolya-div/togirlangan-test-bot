# ─────────────────────────────────────────────
# TURK TILI SPEAKING TEST BOT — .env namunasi
# Bu faylni `.env` nomi bilan nusxalang va haqiqiy qiymatlarni kiriting:
#     cp .env.example .env
# ─────────────────────────────────────────────

# ===== TELEGRAM (MAJBURIY) =====
# @BotFather dan olingan bot token (format: 123456789:AAAbBcC...)
BOT_TOKEN=your_bot_token_here

# Adminlarning Telegram ID lari (vergul bilan ajratiladi)
ADMIN_IDS=123456789,987654321

# ===== DATABASE (MAJBURIY) =====
# PostgreSQL ulanish URL — faqat postgresql+asyncpg:// qo'llab-quvvatlanadi
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# ===== WEBAPP =====
# Agarda NGROK_AUTHTOKEN qo'yilgan bo'lsa — URL avtomatik yangilanadi
WEBAPP_URL=http://localhost:8000

# ===== NGORK TUNNEL (ixtiyoriy) =====
# https://dashboard.ngrok.com dan olinadi — qo'yilmasa bot local ishlayveradi
NGROK_AUTHTOKEN=

# ===== STT (Ovoz → Matn) =====
# Provider: "gemini", "groq" yoki "openai"
STT_PROVIDER=gemini

# Gemini kaliti (bitta)
GEMINI_API_KEY=
# Bir nechta Gemini kaliti (vergul bilan): key1,key2,key3
GEMINI_API_KEYS=
# Tavsiya: gemini-3.6-flash (eski 1.5/2.0/2.5-flash yangi kalitlarda yopilgan)
GEMINI_STT_MODEL=gemini-3.6-flash

# Groq STT kaliti va modeli (STT_PROVIDER=groq bo'lsa)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# ===== AI BAHOLASH =====
# Baholash provideri: "openai" yoki "groq"
AI_PROVIDER=openai

# OpenAI (tavsiya: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq chat (AI_PROVIDER=groq bo'lsa)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Vision — docx savollarni tahlil qilish uchun (Groq)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ===== FAYLLAR =====
# Audio/rasm papkasi (loyiha ichida)
UPLOAD_DIR=data/audios
# Bitta audio fayl uchun maksimal hajm (MB)
MAX_AUDIO_SIZE_MB=50

# ===== CORS =====
# "*" — hamma domendan, yoki domеnlar vergul bilan:
# CORS_ORIGINS=https://site1.com,https://site2.com
CORS_ORIGINS=*

# ===== LOGLAR =====
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO